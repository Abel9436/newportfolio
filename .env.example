# Footer contact form. Copy to .env.local and fill in.
# Without RESEND_API_KEY the form still works: it opens the visitor's mail app instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=abelbk06@gmail.com
# Must be on a domain verified in Resend; the default below only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
